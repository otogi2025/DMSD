# Tomoshibi 点呼机 systemd 服务单元
# 安装：sudo cp config/tomoshibi-rollcall.service /etc/systemd/system/
#       sudo systemctl daemon-reload && sudo systemctl enable --now tomoshibi-rollcall
# 详见 docs/部署SOP.md

[Unit]
Description=Tomoshibi 点呼机主程序
# 等网络就绪 + 系统时钟对时完成（swipe_time 判定依赖 NTP 校准，契约 §3）。
# time-sync.target 必须同时进 Wants：只写 After 而不把它拉进启动事务的话，
# 排序是空转的（target 不被拉起就谈不上「排在它后面」）。不用 Requires——
# 对时单元异常不该拖死离线点呼这个核心能力
After=network-online.target time-sync.target
Wants=network-online.target time-sync.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/rollcall_device
# 走 venv 里的 python，跑 src 包的 main 模块（相对 import 需 -m 方式）
ExecStart=/home/pi/rollcall_device/.venv/bin/python -m src.main --config /home/pi/rollcall_device/config/config.json
Restart=on-failure
RestartSec=5
# 数据目录（密钥 / 名单 / 离线队列 / 音频缓存）需可写
StateDirectory=tomoshibi

[Install]
WantedBy=multi-user.target
