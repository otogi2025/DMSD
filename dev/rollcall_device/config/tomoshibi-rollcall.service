# Tomoshibi 点呼机 systemd 服务单元
# 安装：sudo cp config/tomoshibi-rollcall.service /etc/systemd/system/
#       sudo systemctl daemon-reload && sudo systemctl enable --now tomoshibi-rollcall
# 详见 docs/部署SOP.md

[Unit]
Description=Tomoshibi 点呼机主程序
# 等网络就绪 + 系统时钟对时完成（swipe_time 判定依赖 NTP 校准，契约 §3）。
# time-sync.target 必须同时进 Wants：只写 After 而不把它拉进启动事务的话，
# 排序是空转的（target 不被拉起就谈不上「排在它后面」）。不用 Requires——
# 对时单元异常不该拖死离线点呼这个核心能力
After=network-online.target time-sync.target
Wants=network-online.target time-sync.target

[Service]
Type=simple
# 用户名必须跟烧卡时 Raspberry Pi Imager 里填的用户名一致——本机实际填的是
# rollcall-1（不是文档常假定的 pi）。这个项目定位是开源通用宿舍管理系统，
# 别人部署到别的机器上用户名未必也叫 rollcall-1：换机器时这行和下面两处路径
# （WorkingDirectory / ExecStart）要跟着一起改，三处必须保持一致，否则开机
# 自启会起不来。
User=rollcall-1
WorkingDirectory=/home/rollcall-1/rollcall_device
# 走 venv 里的 python，跑 src 包的 main 模块（相对 import 需 -m 方式）
ExecStart=/home/rollcall-1/rollcall_device/.venv/bin/python -m src.main --config /home/rollcall-1/rollcall_device/config/config.json
Restart=on-failure
RestartSec=5
# 退出码 3 = 硬件初始化失败（接线 / SPI·I2C 开关 / 依赖库），重启多少次都不会自己好。
# 不拦的话现场看到的是「服务每 5 秒重启一次」，真正的报错被刷屏淹没；拦掉后
# 服务停在 failed 状态，systemctl status 第一屏就是那句排查提示。
RestartPreventExitStatus=3
# 数据目录（密钥 / 名单 / 离线队列 / 音频缓存）需可写
StateDirectory=tomoshibi

[Install]
WantedBy=multi-user.target
