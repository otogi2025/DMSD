#!/usr/bin/env bash
# DMSD pre-commit hook — 文档版本号一致性检查
#
# 检查规则：
# "声明性文件"（CLAUDE.md / WIP / TODO / progress_overview）不应硬编码版本号。
# 单源真值 = CHANGELOG.md 顶部。其他文件用指针 "当前版本见 CHANGELOG.md"。
#
# 背景：
#   - 00_admin/文档同步点清单.md §1
#   - 00_admin/2026-04-19_项目审查_backlog.md（D22 / D23 / D25 / L11 一类漏洞）
#   - 2026-04-19 itsuki 发现"迭代到 v0.3.0 了但文件还写 v0.1 / v0.2 / 'v0.2 修订进行中'"
#
# 豁免：行末加 <!-- VERSION_OK --> 注释的行会被跳过。
# 紧急绕过：git commit --no-verify（不推荐）

set -e

# 要检查的"声明性文件"清单（与 00_admin/文档同步点清单.md §1 同步）
DECLARATIVE_FILES=(
    "CLAUDE.md"
    "00_admin/WIP.md"
    "00_admin/TODO.md"
    "00_admin/progress_overview.md"
)

# 每个文件只检查前 N 行（状态声明通常在头部；日志 / 历史引用区放行）
# 30 行够涵盖所有头部 metadata + "当前状态" 段；具体见 00_admin/文档同步点清单.md §1
HEADER_LINES=30

FAIL=0

for file in "${DECLARATIVE_FILES[@]}"; do
    if [ ! -f "$file" ]; then
        continue
    fi

    # 只扫前 HEADER_LINES 行（保留原文件行号），排除 VERSION_OK 豁免行
    FOUND=$(grep -nE "v[0-9]+\.[0-9]+\.[0-9]+" "$file" 2>/dev/null | awk -F: -v max=$HEADER_LINES '$1 <= max' | grep -v "VERSION_OK" || true)

    if [ -n "$FOUND" ]; then
        if [ $FAIL -eq 0 ]; then
            echo ""
            echo "❌ DMSD 声明性文件含有硬编码版本号（违反单源真值规则）："
            echo ""
        fi
        echo "  $file:"
        echo "$FOUND" | sed 's/^/    /'
        echo ""
        FAIL=1
    fi
done

if [ $FAIL -eq 1 ]; then
    echo "─────────────────────────────────────────────"
    echo "解决方法："
    echo "  1. 改成 \"当前版本见 CHANGELOG.md 顶部\" 指针（推荐）"
    echo "  2. 必须保留（历史引用 / 文字模板示例）→ 同一行末尾加 <!-- VERSION_OK -->"
    echo ""
    echo "背景：00_admin/文档同步点清单.md §1"
    echo ""
    echo "紧急绕过（不推荐）：git commit --no-verify"
    echo "─────────────────────────────────────────────"
    exit 1
fi

# ============================================================
# 版本 bump 提醒（2026-04-29 加 — 非阻塞，仅提示）
#
# 触发条件: 本次 commit 包含可能触发版本 bump 的文件改动。
# 目的: 让 CC / itsuki 不漏掉"累积改动该 bump 但忘了"的情况。
# 对应 00_admin/版本管理SOP.md §2 决策树。
# ============================================================

STAGED_FILES=$(git diff --cached --name-only)

BUMP_TRIGGER=""

if echo "$STAGED_FILES" | grep -qE "^01_specs/.+\.md$"; then
    BUMP_TRIGGER="${BUMP_TRIGGER}
  - 01_specs/ 改动（字典 / spec 主体）→ Minor 候选（SOP §2 条件 1+2）"
fi

if echo "$STAGED_FILES" | grep -qE "^02_design/(system_features|flow_design|hardware_design|teacher_requirements)\.md$"; then
    BUMP_TRIGGER="${BUMP_TRIGGER}
  - 02_design/ 主设计文档改动 → Minor 候选（SOP §2 条件 3）"
fi

if echo "$STAGED_FILES" | grep -qE "^03_dev/.*/(IOS_DESIGN_LOG|WEB_DESIGN_LOG)\.md$"; then
    BUMP_TRIGGER="${BUMP_TRIGGER}
  - 03_dev/ 业务设计 LOG 改动 → Minor 候选（SOP §2 条件 4）"
fi

if [ -n "$BUMP_TRIGGER" ]; then
    echo ""
    echo "ℹ️  版本 bump 提醒（非阻塞，仅提示）"
    echo "─────────────────────────────────────────────"
    echo "本次改动可能触发版本 bump：${BUMP_TRIGGER}"
    echo ""
    echo "  → 对照 .claude/skills/version-bump/SKILL.md §2 决策树判断"
    echo "  → 单次不 bump 也 OK，但累积 5+ commit 时回看 SKILL §10"
    echo "─────────────────────────────────────────────"
    echo ""
fi

# ============================================================
# 文件联动检查（2026-05-04 加 — 非阻塞，仅提示）
#
# 触发条件: staged 文件命中 00_admin/hooks/lib/sync-rules.sh 中任一规则
# 目的: 改了 X 但漏改了联动文件 Y → 当场提醒（不等会话结束 §3 文件关联追踪）
# 对应 CLAUDE.md §会话结束 §3 文件关联追踪表 + §4 规范文档同步检查
# ============================================================

# 自动用 git rev-parse --show-toplevel 找仓库根，确保 source 路径正确
REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || echo "")
if [ -n "$REPO_ROOT" ] && [ -f "$REPO_ROOT/00_admin/hooks/lib/sync-rules.sh" ]; then
    # shellcheck source=lib/sync-rules.sh
    source "$REPO_ROOT/00_admin/hooks/lib/sync-rules.sh"

    # staged 改动 = 已经 git add 的文件（含新增 / 修改 / 改名）
    # core.quotepath=false: 中文路径不被 quote，规则 grep 才能匹配
    STAGED_LIST=$(git -c core.quotepath=false diff --cached --name-only)

    if [ -n "$STAGED_LIST" ]; then
        # 把 staged 文件列表转成数组传入
        # 2026-05-22 修 FC-033：临时把 IFS 设成换行符（让 shell 只按行拆参数，
        # 不按空格拆），保护带空格的路径（如 `tomoshibi_flame 2.png`）
        # || true: check_sync_for_files return triggered_count 非 0 时不让 set -e 终止
        SC_OLD_IFS=$IFS
        IFS=$'\n'
        SYNC_OUTPUT=$(check_sync_for_files $STAGED_LIST 2>&1 || true)
        IFS=$SC_OLD_IFS

        # 新建文件检查（声明性文件登记提醒）
        STAGED_NEW=$(git -c core.quotepath=false diff --cached --name-status | awk '$1 == "A" {print $2}' || true)
        if [ -n "$STAGED_NEW" ]; then
            DECL_OUTPUT=$(check_new_declarative_files "$STAGED_NEW" 2>&1 || true)
            SYNC_OUTPUT="${SYNC_OUTPUT}${DECL_OUTPUT}"
        fi

        if [ -n "$SYNC_OUTPUT" ]; then
            echo ""
            echo "ℹ️  文件联动提醒（非阻塞，仅提示）"
            echo "─────────────────────────────────────────────"
            echo "$SYNC_OUTPUT"
            echo ""
            echo "─────────────────────────────────────────────"
            echo "  → 规则源: 00_admin/hooks/lib/sync-rules.sh"
            echo "  → 中途随时查: bash bin/sync-check.sh"
            echo "  → 故意漏 / 不需联动 → 直接 commit 即可（仅提醒）"
            echo "─────────────────────────────────────────────"
            echo ""
        fi
    fi
fi

# ============================================================
# 密钥泄露扫描（阻塞 — 公开仓库防护）
#
# 目的：仓库公开，防止把写死在代码里的真实密钥（发邮件通行证 /
#   登录密钥 / 私钥）提交上去。
#   .gitignore 已挡 .env / .db / .key 文件；本检查补的是
#   "密钥被直接写死进某个源码文件" 这种手滑。
#
# 只扫本次 git add 的新增行，只匹配高置信度的厂商密钥格式
# （SendGrid / AWS / Google / Slack）+ 私钥块，避免误伤普通代码。
# 注意：只认这几种已知格式，不是万能；GitHub 自带的密钥扫描是第二道。
#
# 误报绕过：该行末尾加  # pragma: allowlist secret
# 紧急绕过：git commit --no-verify
# ============================================================

SECRET_SCAN_FILES=$(git diff --cached --name-only --diff-filter=ACM \
    | grep -vE '\.example$|^00_admin/hooks/' || true)

SECRET_PATTERN='SG\.[A-Za-z0-9_-]{16,}\.[A-Za-z0-9_-]{16,}|-----BEGIN [A-Z ]*PRIVATE KEY-----|AKIA[0-9A-Z]{16}|AIza[0-9A-Za-z_-]{35}|xox[baprs]-[0-9A-Za-z-]{10,}'

SECRET_HITS=""
for f in $SECRET_SCAN_FILES; do
    [ -f "$f" ] || continue
    HIT=$(git diff --cached -U0 -- "$f" \
        | grep -E '^\+' | grep -vE '^\+\+\+' \
        | grep -vE 'pragma: allowlist secret' \
        | grep -E "$SECRET_PATTERN" || true)
    if [ -n "$HIT" ]; then
        SECRET_HITS="${SECRET_HITS}
  $f:
$(echo "$HIT" | sed 's/^+/    /')"
    fi
done

if [ -n "$SECRET_HITS" ]; then
    echo ""
    echo "🔴 检测到疑似密钥被写进代码（公开仓库，已阻止提交）："
    echo "$SECRET_HITS"
    echo ""
    echo "─────────────────────────────────────────────"
    echo "怎么办："
    echo "  1. 把密钥从代码里删掉，改从 .env 读（.env 已被 .gitignore 挡，不会提交）"
    echo "  2. 确实误报（示例 / 占位符）→ 该行末尾加：# pragma: allowlist secret"
    echo "  3. 紧急绕过（不推荐）：git commit --no-verify"
    echo "─────────────────────────────────────────────"
    exit 1
fi

echo "✅ pre-commit 一致性检查通过"
exit 0
