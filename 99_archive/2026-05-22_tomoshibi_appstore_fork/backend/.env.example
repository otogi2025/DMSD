# Tomoshibi Backend — App Store 上架版生产环境变量模板
# 用法：cp .env.example .env → 填真实值 → docker compose 会自动读
# ⚠️ .env 绝不能 commit / 上传到 GitHub（含密钥）

# ---- 应用 ----
# ⚠️ APP_ENV 必须 production — 否则 app/main.py 启动时跑 create_all() 绕过 alembic
# 默认值 "dev" 在 app/config.py:21，会导致 prod 部署时直接从 ORM 建表（无 alembic_version 跟踪）
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000

# ---- DB（VPS 生产 = Postgres 16，docker-compose 内部网络）----
# 这条 URL 由 docker-compose.yml 自动拼，本文件主要给非 Docker 部署 / 本地调试参考
DATABASE_URL=postgresql+psycopg://tomoshibi:CHANGE_ME@postgres:5432/tomoshibi

# Postgres 容器初始化用（被 docker-compose.yml 读取，name 必须跟下面一致）
POSTGRES_DB=tomoshibi
POSTGRES_USER=tomoshibi
# 强密码：用 `openssl rand -base64 24` 生成
POSTGRES_PASSWORD=CHANGE_ME_strong_password

# ---- 认证 (JWT) ----
# 32 字节十六进制（`openssl rand -hex 32` 生成 64 字符）
# 泄漏 = 任何人能伪造 token，上线必须改默认值
JWT_SECRET=CHANGE_ME_to_64_hex_chars_via_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MIN=1440           # 24h (= 60 * 24)
JWT_REFRESH_EXPIRE_MIN=43200         # 30d

# ---- メール（Apple 审核期间不强制；上线后用 SendGrid / AWS SES）----
# 暂时空白 — 注册后邮箱通知功能 v1.0 不依赖（只在 v1.x 加）
SENDGRID_API_KEY=
EMAIL_FROM=noreply@tomoshibi.cc
EMAIL_FROM_NAME=Tomoshibi

# ---- CORS ----
# 允许的前端来源（逗号分隔）
# iOS app 不走 CORS（原生客户端），所以只列 web 域名
# teacher_web 上线后加 https://teacher.tomoshibi.cc
CORS_ORIGINS=https://api.tomoshibi.cc

# ---- ログ ----
LOG_LEVEL=INFO
