# Caddy 反代 + 自动 HTTPS（Let's Encrypt 自动签）
# 替换 api.tomoshibi.cc 为 itsuki 实际域名
# 部署前确认 DNS A record 已指向 VPS 公网 IP（domain → IP）

api.tomoshibi.cc {
    reverse_proxy api:8000

    # 标准安全头
    header {
        # HSTS — 强制 HTTPS 1 年
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        # 防 MIME sniff
        X-Content-Type-Options "nosniff"
        # 防 clickjacking（API 不需要被 iframe）
        X-Frame-Options "DENY"
        # 防泄漏 referrer
        Referrer-Policy "strict-origin-when-cross-origin"
        # 隐藏 server 头
        -Server
    }

    # 健康检查路径不记 access log（避免 UptimeRobot 噪音）
    @healthz path /healthz
    log @healthz {
        output discard
    }

    log {
        output file /data/access.log {
            roll_size 100mb
            roll_keep 5
        }
        format json
    }
}
