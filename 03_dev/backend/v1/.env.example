# Tomoshibi Backend v1.0 — 环境变量样本
# 使用方法: 复制成 .env (gitignored) 后填值

# ---- 应用 ----
APP_ENV=dev                          # dev | staging | production
APP_HOST=0.0.0.0
APP_PORT=8000

# ---- DB ----
# 开发 (SQLite, 文件 = ./tomoshibi_dev.db, 自动创建)
DATABASE_URL=sqlite:///./tomoshibi_dev.db
# 生产 (PostgreSQL 16+)
# DATABASE_URL=postgresql+psycopg://tomoshibi:password@localhost:5432/tomoshibi

# ---- 认证 (JWT) ----
# ⚠️ 2026-05-22 修 Codex FC-011：原示例 `change-me-in-production-32-bytes-minimum-...`
#    超过 32 字符 + 不在 forbidden 集合 → 复制后能绕过生产检查启动。
#    现示例改成短字符串（forbidden 集合已禁 `change-me-in-production`）
#    → 生产启动直接 RuntimeError，强制 itsuki 设真值
# 32 桁以上的真値を `openssl rand -hex 32` で生成して入れる
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MIN=1440           # 24h (= 60 * 24)
JWT_REFRESH_EXPIRE_MIN=43200         # 30d

# ---- メール (D1 SendGrid) ----
# https://app.sendgrid.com/settings/api_keys から API Key (Full Access or Mail Send)
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 送信元 (SendGrid 上で Verified Sender に登録済 must)
EMAIL_FROM=noreply@tomoshibi.example.jp
EMAIL_FROM_NAME=Tomoshibi 通知

# ---- CORS ----
# 开发：本地 dev server 端口（Vite 5173 / standalone 8787 / React 3000）
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8787
# ⚠️ 生产：必须改成真实域名，localhost / 127.0.0.1 / * 在 APP_ENV=production 时会 fail-fast
# 示例：
# CORS_ORIGINS=https://tomoshibi.example.jp,https://teacher.tomoshibi.example.jp

# ---- 老师网页静态文件服务（B5 同 origin 部署）----
# 留空时跳过（dev 下用 vite/standalone 单跑）；生产时填 teacher_web 构建产物目录
# 挂载路径：/teacher（index.html 自动响应）
TEACHER_WEB_DIR=
# 生产示例（vite build 产物）：
# TEACHER_WEB_DIR=/app/teacher_web/dist

# ---- ログ ----
LOG_LEVEL=INFO
