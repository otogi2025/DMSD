#!/usr/bin/env bash
# ============================================================
#   Tomoshibi · 灯火 · 寮管理システム · demo CLI
# ============================================================
# 使い方:
#   ./tomoshibi            # start (default)
#   ./tomoshibi start      # demo サーバー起動 + ブラウザ自動起動
#   ./tomoshibi stop       # サーバー停止
#   ./tomoshibi status     # サーバー稼働状態
#   ./tomoshibi ip         # Mac の LAN IP 表示（iPhone Shortcuts 用）
#   ./tomoshibi pack       # 単一 HTML ファイル生成（demo 携帯用）
#   ./tomoshibi rebuild    # jsx を index.html に再インライン
#   ./tomoshibi help
# ============================================================

set -e

# --- config ---
readonly PORT=8787
readonly HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly APP_NAME="Tomoshibi · 灯火"
readonly APP_VERSION="v0.1.0-demo"

# --- ANSI colors ---
if [ -t 1 ]; then
  readonly C_RESET="\033[0m"
  readonly C_DIM="\033[2m"
  readonly C_BOLD="\033[1m"
  readonly C_COBALT="\033[38;5;68m"
  readonly C_OK="\033[38;5;71m"
  readonly C_WARN="\033[38;5;214m"
  readonly C_ERR="\033[38;5;167m"
  readonly C_INK="\033[38;5;234m"
  readonly C_GOLD="\033[38;5;221m"
else
  readonly C_RESET="" C_DIM="" C_BOLD="" C_COBALT="" C_OK="" C_WARN="" C_ERR="" C_INK="" C_GOLD=""
fi

# --- helpers ---
banner() {
  echo
  printf "  ${C_GOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}\n"
  printf "  ${C_GOLD}|${C_RESET}  🔥  ${C_BOLD}Tomoshibi${C_RESET} ${C_DIM}· 灯火 · 寮管理システム${C_RESET}\n"
  printf "  ${C_GOLD}|${C_RESET}      ${C_DIM}demo CLI · ${APP_VERSION}${C_RESET}\n"
  printf "  ${C_GOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}\n"
  echo
}

ok()   { printf "  ${C_OK}✓${C_RESET} %s\n" "$1"; }
warn() { printf "  ${C_WARN}⚠${C_RESET} %s\n" "$1"; }
err()  { printf "  ${C_ERR}✗${C_RESET} %s\n" "$1" >&2; }
info() { printf "  ${C_COBALT}▸${C_RESET} %s\n" "$1"; }
dim()  { printf "  ${C_DIM}%s${C_RESET}\n" "$1"; }

is_running() {
  lsof -ti tcp:$PORT >/dev/null 2>&1
}

get_ip() {
  # UDP trick で outbound IP を取る（热点 / Wi-Fi どちらも正確）
  python3 - <<'PY' 2>/dev/null || echo "127.0.0.1"
import socket
try:
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    s.connect(("8.8.8.8", 80))
    print(s.getsockname()[0])
    s.close()
except Exception:
    print("127.0.0.1")
PY
}

# --- commands ---
cmd_start() {
  banner

  cd "$HERE"

  if is_running; then
    warn "既に port $PORT で稼働中です → 一度停止します"
    lsof -ti tcp:$PORT | xargs kill -9 2>/dev/null || true
    sleep 0.3
  fi

  info "ポート $PORT を確保..."
  ok "ポート空き確認"

  local ip
  ip=$(get_ip)
  info "LAN IP: ${C_BOLD}${ip}${C_RESET}"

  info "ブラウザを起動中..."
  ( sleep 1.2 && open "http://localhost:$PORT/" ) &

  echo
  printf "  ${C_DIM}─────────────────────────────────────────────${C_RESET}\n"
  printf "  ${C_COBALT}●${C_RESET}  ローカル表示     ${C_BOLD}http://localhost:$PORT/${C_RESET}\n"
  printf "  ${C_COBALT}●${C_RESET}  iPhone 接続用    ${C_BOLD}http://$ip:$PORT/${C_RESET}\n"
  printf "  ${C_COBALT}●${C_RESET}  点呼エンドポイント ${C_DIM}POST${C_RESET} ${C_BOLD}http://$ip:$PORT/checkin?no=XX${C_RESET}\n"
  printf "  ${C_DIM}─────────────────────────────────────────────${C_RESET}\n"
  echo
  dim "終了: Ctrl+C · ウィンドウを閉じる"
  echo

  # 2026-05-26: 退 demo_server.py（文件不存在），改 Python 内建静态服务器
  # NFC 実時間ポーリング機能は失効中（要恢复需写 demo_server.py）
  cd src
  exec python3 -m http.server $PORT
}

cmd_stop() {
  banner
  if is_running; then
    info "port $PORT の server を停止中..."
    lsof -ti tcp:$PORT | xargs kill -9 2>/dev/null || true
    sleep 0.3
    ok "停止しました"
  else
    warn "稼働中の server はありません"
  fi
  echo
}

cmd_status() {
  banner
  if is_running; then
    local pid
    pid=$(lsof -ti tcp:$PORT | head -1)
    ok "稼働中 (PID $pid, port $PORT)"
    info "LAN IP: ${C_BOLD}$(get_ip)${C_RESET}"
    printf "  ${C_DIM}http://localhost:$PORT/${C_RESET}\n"
  else
    warn "停止中"
    dim "起動: ./tomoshibi start"
  fi
  echo
}

cmd_ip() {
  banner
  local ip
  ip=$(get_ip)
  info "Mac の LAN IP: ${C_BOLD}${ip}${C_RESET}"
  echo
  dim "iPhone Shortcuts 用 URL 例:"
  printf "  ${C_BOLD}http://$ip:$PORT/checkin?no=00${C_RESET}  ${C_DIM}(リュウ イヒ)${C_RESET}\n"
  printf "  ${C_BOLD}http://$ip:$PORT/checkin?no=01${C_RESET}  ${C_DIM}(佐藤 健太)${C_RESET}\n"
  echo
}

cmd_rebuild() {
  banner
  info "components/*.jsx を index.html にインライン化中..."
  cd "$HERE"
  python3 - <<'PY'
import re
from pathlib import Path
root = Path('.').resolve()
idx = root / 'src' / 'index.html'
html = idx.read_text(encoding='utf-8')
html = re.sub(r'<script type="text/babel" data-source="(components/[^"]+)">\n.*?\n</script>', r'<script type="text/babel" src="\1"></script>', html, flags=re.DOTALL)
def inline(m):
    rel = m.group(1)
    p = root / 'src' / rel
    return f'<script type="text/babel" data-source="{rel}">\n{p.read_text(encoding="utf-8")}\n</script>'
html = re.sub(r'<script type="text/babel" src="(components/[^"]+)"></script>', inline, html)
idx.write_text(html, encoding='utf-8')
n = len(re.findall(r'data-source="components/', html))
kb = idx.stat().st_size // 1024
print(f"  ✓ {n} components · {kb} KB")
PY
  echo
}

cmd_pack() {
  banner
  info "単一ファイル HTML を生成中..."
  cd "$HERE"
  python3 build_single_file.py | sed 's/^/  /'
  echo
}

cmd_help() {
  banner
  printf "  ${C_BOLD}使い方${C_RESET}\n\n"
  printf "    ${C_COBALT}./tomoshibi${C_RESET}            demo 起動 (default)\n"
  printf "    ${C_COBALT}./tomoshibi start${C_RESET}      同上\n"
  printf "    ${C_COBALT}./tomoshibi stop${C_RESET}       停止\n"
  printf "    ${C_COBALT}./tomoshibi status${C_RESET}     状態確認\n"
  printf "    ${C_COBALT}./tomoshibi ip${C_RESET}         LAN IP と Shortcuts URL\n"
  printf "    ${C_COBALT}./tomoshibi rebuild${C_RESET}    jsx を index.html に再インライン\n"
  printf "    ${C_COBALT}./tomoshibi pack${C_RESET}       単一ファイル HTML 生成\n"
  printf "    ${C_COBALT}./tomoshibi help${C_RESET}       このヘルプ\n"
  echo
}

# --- dispatch ---
case "${1:-start}" in
  start|"")  cmd_start ;;
  stop)      cmd_stop ;;
  status)    cmd_status ;;
  ip)        cmd_ip ;;
  rebuild)   cmd_rebuild ;;
  pack)      cmd_pack ;;
  help|-h|--help) cmd_help ;;
  *)
    err "未知のコマンド: $1"
    cmd_help
    exit 1
    ;;
esac
