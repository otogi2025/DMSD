{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/00_admin/hooks/pre-bash-destructive-block.sh",
            "async": false,
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/00_admin/hooks/post-edit-sync-check.sh",
            "async": false,
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/00_admin/hooks/post-edit-memory-check.sh",
            "async": false,
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/00_admin/hooks/post-edit-japanese-comment-check.sh",
            "async": false,
            "timeout": 8
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/00_admin/hooks/post-edit-timestamp-check.sh",
            "async": false,
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/00_admin/hooks/post-edit-version-hardcode-check.sh",
            "async": false,
            "timeout": 5
          }
        ]
      }
    ]
  }
}
